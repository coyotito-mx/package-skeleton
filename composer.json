{
    "name": "{{namespace|slug,reverse}}",
    "description": "{{description}}",
    "license": "{{license|acronym}}",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "laravel/pint": "^v1.25.1",
        "phpstan/phpstan": "^2.1.40",
        "rector/rector": "^2.3.5"
    },
    "autoload": {
        "psr-4": {
            "{{namespace|escape}}\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "test:ci": "@php vendor/bin/pest --ci",
        "lint": "@php vendor/bin/phpstan --analyse --memory-limit=1G",
        "style": "@php vendor/bin/pint",
        "style:test": "@style --test",
        "lint:with-style": [
            "@lint",
            "@style:test"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "prefer-stable": true
}
