{
    "name": "{{namespace|slug,reverse}}",
    "description": "{{description}}",
    "license": "{{license|acronym}}",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "laravel/pint": "^v1.25.1",
        "phpstan/phpstan": "^2.1.40",
        "rector/rector": "^2.3.5"
    },
    "autoload": {
        "psr-4": {
            "{{namespace|escape}}\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php ...",
        "lint": "@php phpstan analyse --memory-limit=1G",
        "style": "@php pint --test",
        "style:fix": "@php pint",
        "refactor": "@php rector --dry-run --memory-limit=1G",
        "refactor:fix": "@php rector --memory-limit=1G",
        "ci:lint": [
            "@lint",
            "@style"
        ],
        "check": [
            "@ci:lint",
            "@refactor"
        ],
        "fix": [
            "@refactor:fix",
            "@style:fix"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "prefer-stable": true
}
